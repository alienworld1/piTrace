{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi-trace",
  "version": "0.1.0",
  "identifier": "com.alienworld.pi-trace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pi-trace",
        "width": 1000,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg"],
    "resources": {
      "../.agent/exiftool/exiftool": "exiftool/exiftool",
      "../.agent/exiftool/lib/": "exiftool/lib/",
      "../.agent/exiftool/README": "exiftool/README",
      "../.agent/exiftool/META.json": "exiftool/META.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
